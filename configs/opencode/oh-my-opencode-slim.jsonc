{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "preset": "author",
  "presets": {
    "author": {
      "orchestrator": {
        "model": "openrouter/moonshotai/kimi-k2.6",
        "skills": ["*"],
        "mcps": ["*", "websearch"],
      },
      "oracle": {
        "model": "openrouter/moonshotai/kimi-k2.6",
        "variant": "high",
        "skills": [],
        "mcps": [],
      },
      "librarian": {
        "model": "anthropic/claude-sonnet-4-6",
        "variant": "low",
        "skills": [],
        "mcps": ["websearch", "context7", "grep_app"],
      },
      "explorer": {
        "model": "anthropic/claude-sonnet-4-6",
        "variant": "low",
        "skills": [],
        "mcps": [],
      },
      "designer": {
        "model": "openrouter/google/gemini-3.1-pro-preview",
        "skills": ["agent-browser"],
        "mcps": [],
      },
      "fixer": {
        "model": "anthropic/claude-sonnet-4-6",
        "variant": "low",
        "skills": [],
        "mcps": [],
      },
    },
  },

  // Council — plugin defaults reference direct openai/*, which isn't configured.
  // Override with providers you actually have (Anthropic + OpenRouter).
  "council": {
    "master": { "model": "openrouter/moonshotai/kimi-k2.6" },
    "presets": {
      "default": {
        "alpha": { "model": "openrouter/moonshotai/kimi-k2.6" },
        "beta": { "model": "openrouter/google/gemini-3.1-pro-preview" },
        "gamma": { "model": "openrouter/openai/gpt-5.4" },
      },
    },
  },

  "fallback": {
    "enabled": true,
    "timeoutMs": 15000,
    "retryDelayMs": 500,
    "chains": {
      "orchestrator": ["openrouter/openai/gpt-5.4"],
      "oracle": ["openrouter/openai/gpt-5.4"],
      "librarian": ["openrouter/openai/gpt-5.4-mini"],
      "explorer": ["openrouter/openai/gpt-5.4-mini"],
      "designer": ["anthropic/claude-sonnet-4-6"],
      "fixer": ["openrouter/openai/gpt-5.4-mini"],
    },
  },

  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
  },
}
