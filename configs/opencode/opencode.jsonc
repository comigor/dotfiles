{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-4-7",
  "plugin": ["opencode-beads@latest", "true-mem@1.0.14", "oh-my-opencode-slim"],
  "mcp": {
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
    },
  },
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}",
      },
    },
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
      },
      "models": {
        "moonshotai/kimi-k2.6": {
          "name": "Kimi K2.6",
        },
      },
    },
  },
  "permission": {
    "bash": {
      "rm -rf *": "deny",
      "sudo *": "deny",
      "git push --force*": "ask",
      "*": "allow",
    },
  },
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
  },
}
