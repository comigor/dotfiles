{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-4-8",
  "instructions": ["~/.agents/AGENTS.md"],
  "plugin": [
    "openrtk",
    "opencode-beads@latest",
    "true-mem@1.0.14",
    "oh-my-opencode-slim",
    "@warp-dot-dev/opencode-warp@0.1.5",
  ],
  "mcp": {
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
    },
    "signoz": {
      "type": "remote",
      "url": "https://mcp.us.signoz.cloud/mcp",
    },
    "yfmcp": {
      "type": "local",
      "command": ["uvx", "yfmcp"],
    },
  },
  "formatter": true,
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}",
      },
    },
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
      },
    },
  },
  "permission": {
    "websearch": "allow",
    "webfetch": "allow",
    "bash": {
      "rm -rf *": "deny",
      "sudo *": "deny",
      "git push --force*": "ask",

      // kubectl: read-only verbs auto-allowed
      "kubectl get*": "allow",
      "kubectl describe*": "allow",
      "kubectl logs*": "allow",
      "kubectl top*": "allow",
      "kubectl explain*": "allow",
      "kubectl version*": "allow",
      "kubectl cluster-info*": "allow",
      "kubectl api-resources*": "allow",
      "kubectl api-versions*": "allow",
      "kubectl config view*": "allow",
      "kubectl config get-*": "allow",
      "kubectl config current-context*": "allow",
      "kubectl auth can-i*": "allow",
      "kubectl diff*": "allow",
      "kubectl wait*": "allow",
      "kubectl events*": "allow",

      "rtx kubectl get*": "allow",
      "rtx kubectl describe*": "allow",
      "rtx kubectl logs*": "allow",
      "rtx kubectl top*": "allow",
      "rtx kubectl explain*": "allow",
      "rtx kubectl version*": "allow",
      "rtx kubectl cluster-info*": "allow",
      "rtx kubectl api-resources*": "allow",
      "rtx kubectl api-versions*": "allow",
      "rtx kubectl config view*": "allow",
      "rtx kubectl config get-*": "allow",
      "rtx kubectl config current-context*": "allow",
      "rtx kubectl auth can-i*": "allow",
      "rtx kubectl diff*": "allow",
      "rtx kubectl wait*": "allow",
      "rtx kubectl events*": "allow",

      // kubectl: mutating / destructive / privileged verbs require confirmation
      "kubectl apply*": "ask",
      "kubectl create*": "ask",
      "kubectl delete*": "ask",
      "kubectl edit*": "ask",
      "kubectl patch*": "ask",
      "kubectl replace*": "ask",
      "kubectl scale*": "ask",
      "kubectl rollout*": "ask",
      "kubectl drain*": "ask",
      "kubectl cordon*": "ask",
      "kubectl uncordon*": "ask",
      "kubectl taint*": "ask",
      "kubectl label*": "ask",
      "kubectl annotate*": "ask",
      "kubectl exec*": "ask",
      "kubectl attach*": "ask",
      "kubectl cp*": "ask",
      "kubectl port-forward*": "ask",
      "kubectl proxy*": "ask",
      "kubectl run*": "ask",
      "kubectl set*": "ask",
      "kubectl debug*": "ask",
      "kubectl config set*": "ask",
      "kubectl config use-context*": "ask",
      "kubectl config delete-*": "ask",
      "kubectl config rename-context*": "ask",

      "rtx kubectl apply*": "ask",
      "rtx kubectl create*": "ask",
      "rtx kubectl delete*": "ask",
      "rtx kubectl edit*": "ask",
      "rtx kubectl patch*": "ask",
      "rtx kubectl replace*": "ask",
      "rtx kubectl scale*": "ask",
      "rtx kubectl rollout*": "ask",
      "rtx kubectl drain*": "ask",
      "rtx kubectl cordon*": "ask",
      "rtx kubectl uncordon*": "ask",
      "rtx kubectl taint*": "ask",
      "rtx kubectl label*": "ask",
      "rtx kubectl annotate*": "ask",
      "rtx kubectl exec*": "ask",
      "rtx kubectl attach*": "ask",
      "rtx kubectl cp*": "ask",
      "rtx kubectl port-forward*": "ask",
      "rtx kubectl proxy*": "ask",
      "rtx kubectl run*": "ask",
      "rtx kubectl set*": "ask",
      "rtx kubectl debug*": "ask",
      "rtx kubectl config set*": "ask",
      "rtx kubectl config use-context*": "ask",
      "rtx kubectl config delete-*": "ask",
      "rtx kubectl config rename-context*": "ask",

      "*": "allow",
    },
    "external_directory": {
      "~/Projects/**": "allow",
      "/tmp/**": "allow",
      "~/.local/share/mise/installs/go/**": "allow",
    },
  },
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
  },
}
