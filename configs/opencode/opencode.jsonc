{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-4-7",
  "plugin": ["openrtk", "opencode-beads@latest", "true-mem@1.0.14", "oh-my-opencode-slim"],
  "mcp": {
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
    },
  },
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}",
      },
    },
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
      },
      "models": {
        "moonshotai/kimi-k2.6": {
          "name": "Kimi K2.6",
        },
      },
    },
  },
  "permission": {
    "websearch": "allow",
    "webfetch": "allow",
    "bash": {
      "rm -rf *": "deny",
      "sudo *": "deny",
      "git push --force*": "ask",

      // kubectl: read-only verbs auto-allowed
      "kubectl get*": "allow",
      "kubectl describe*": "allow",
      "kubectl logs*": "allow",
      "kubectl top*": "allow",
      "kubectl explain*": "allow",
      "kubectl version*": "allow",
      "kubectl cluster-info*": "allow",
      "kubectl api-resources*": "allow",
      "kubectl api-versions*": "allow",
      "kubectl config view*": "allow",
      "kubectl config get-*": "allow",
      "kubectl config current-context*": "allow",
      "kubectl auth can-i*": "allow",
      "kubectl diff*": "allow",
      "kubectl wait*": "allow",
      "kubectl events*": "allow",

      // kubectl: mutating / destructive / privileged verbs require confirmation
      "kubectl apply*": "ask",
      "kubectl create*": "ask",
      "kubectl delete*": "ask",
      "kubectl edit*": "ask",
      "kubectl patch*": "ask",
      "kubectl replace*": "ask",
      "kubectl scale*": "ask",
      "kubectl rollout*": "ask",
      "kubectl drain*": "ask",
      "kubectl cordon*": "ask",
      "kubectl uncordon*": "ask",
      "kubectl taint*": "ask",
      "kubectl label*": "ask",
      "kubectl annotate*": "ask",
      "kubectl exec*": "ask",
      "kubectl attach*": "ask",
      "kubectl cp*": "ask",
      "kubectl port-forward*": "ask",
      "kubectl proxy*": "ask",
      "kubectl run*": "ask",
      "kubectl set*": "ask",
      "kubectl debug*": "ask",
      "kubectl config set*": "ask",
      "kubectl config use-context*": "ask",
      "kubectl config delete-*": "ask",
      "kubectl config rename-context*": "ask",

      "*": "allow",
    },
    "external_directory": {
      "~/Projects/**": "allow",
      "/tmp/**": "allow",
    },
  },
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
  },
}
