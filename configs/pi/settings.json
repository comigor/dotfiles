{
  "defaultProvider": "openrouter",
  "defaultModel": "deepseek/deepseek-v4.1-flash",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "showCacheMissNotices": true,
  "theme": "dark",
  "quietStartup": true,
  "collapseChangelog": true,
  "doubleEscapeAction": "tree",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 32000
  },
  "branchSummary": {
    "skipPrompt": false
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetryDelayMs": 60000
    }
  },
  "terminal": {
    "showImages": true,
    "imageWidthCells": 60,
    "showTerminalProgress": true
  },
  "npmCommand": [
    "npm",
    "--registry=https://registry.npmjs.org/"
  ],
  "enableSkillCommands": true,
  "enableInstallTelemetry": false,
  "enableAnalytics": true,
  "lastChangelogVersion": "1.4.0",
  "packages": [
    "npm:@sherif-fanous/pi-rtk",
    "npm:pi-hashline-edit",
    "npm:pi-lens",
    "npm:bladebro",
    "npm:pi-fabric",
    "npm:pi-atelier",
    "npm:pi-btw",
    {
      "source": "/Users/igor/.config/nono/packages/nolabs-ai/pi"
    },
    "npm:@plannotator/pi-extension"
  ],
  "piBolt": {
    "packagesOverlay": true,
    "packages": [
      "npm:opensec-pi-todo@2.13.1",
      "npm:opensec-pi-fff@0.11.0",
      "./packages/omp-memory"
    ]
  }
}