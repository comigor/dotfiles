{
  "defaultProvider": "openrouter-half",
  "defaultModel": "deepseek/deepseek-v4.1-flash",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "theme": "dark",
  "quietStartup": true,
  "collapseChangelog": true,
  "doubleEscapeAction": "tree",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 32000
  },
  "branchSummary": {
    "skipPrompt": false
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetryDelayMs": 60000
    }
  },
  "terminal": {
    "showImages": true,
    "imageWidthCells": 60,
    "showTerminalProgress": true
  },
  "npmCommand": [
    "npm",
    "--registry=https://registry.npmjs.org/"
  ],
  "enableSkillCommands": true,
  "enableInstallTelemetry": false,
  "enableAnalytics": true,
  "lastChangelogVersion": "1.4.0",
  "packages": [
    "npm:@sherif-fanous/pi-rtk",
    "npm:pi-hashline-edit",
    "npm:pi-lens",
    "npm:bladebro",
    "npm:@plannotator/pi-extension",
    "npm:pi-fabric",
    "npm:pi-memory",
    "npm:pi-atelier",
    "npm:pi-btw"
  ],
  "piBolt": {
    "packagesOverlay": true,
    "packages": [
      "npm:opensec-pi-subagents@0.20.9",
      "npm:opensec-pi-todo@2.13.1",
      "npm:opensec-pi-fff@0.11.0"
    ]
  },
  "subagents": {
    "defaultModel": "openrouter-half/deepseek/deepseek-v4.1-flash",
    "agentOverrides": {
      "reviewer": {
        "model": "openrouter-half/moonshotai/kimi-k3.1-pro",
        "thinking": "high"
      },
      "oracle": {
        "model": "openrouter-half/moonshotai/kimi-k3.1-pro",
        "thinking": "high"
      },
      "researcher": {
        "model": "modal-flash-half/zai-org/GLM-5.3-Flash",
        "thinking": "high"
      },
      "scout": {
        "model": "modal-flash-half/zai-org/GLM-5.3-Flash",
        "thinking": "high"
      },
      "worker": {
        "model": "modal-flash-half/zai-org/GLM-5.3-Flash",
        "thinking": "high"
      },
      "tdd-worker": {
        "model": "modal-flash-half/zai-org/GLM-5.3-Flash",
        "thinking": "high"
      }
    }
  }
}