{
  "defaultProvider": "openrouter",
  "defaultModel": "z-ai/glm-5.2",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "theme": "dark",
  "quietStartup": true,
  "collapseChangelog": true,
  "doubleEscapeAction": "none",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 32000
  },
  "branchSummary": {
    "skipPrompt": false
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetryDelayMs": 60000
    }
  },
  "terminal": {
    "showImages": true,
    "imageWidthCells": 60,
    "showTerminalProgress": true
  },
  "npmCommand": ["npm", "--registry=https://registry.npmjs.org/"],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:pi-btw",
    "npm:@mazli/pi-ask-user-question",
    "npm:pi-powerline-footer",
    "npm:pi-hermes-memory",
    "npm:@pi-unipi/notify",
    "npm:@sherif-fanous/pi-rtk",
    "../../Projects/jong-pi-extensions/packages/diff-review",
    "../../Projects/pi-roaming",
    "npm:pi-hashline-edit",
    "npm:pi-lens",
    "npm:pi-edit-session-in-place",
    "npm:@zosmaai/pi-llm-wiki"
  ],
  "lastChangelogVersion": "0.79.9",
  "subagents": {
    "agentOverrides": {
      "oracle": {
        "model": "anthropic/claude-opus-4-8",
        "thinking": "xhigh",
        "fallbackModels": ["openrouter/openai/gpt-5.5-pro", "openrouter/moonshotai/kimi-k2.6"]
      },
      "researcher": {
        "model": "anthropic/claude-sonnet-4-6",
        "thinking": "low",
        "fallbackModels": ["openrouter/openai/gpt-5.5"]
      },
      "scout": {
        "model": "anthropic/claude-sonnet-4-6",
        "thinking": "low",
        "fallbackModels": ["openrouter/openai/gpt-5.5"]
      },
      "worker": {
        "model": "anthropic/claude-sonnet-4-6",
        "thinking": "low",
        "fallbackModels": ["openrouter/openai/gpt-5.5"]
      }
    }
  },
  "enableSkillCommands": false,
  "enableInstallTelemetry": false
}
