{
  "mcpServers": {
    "argocd-mcp": {
      "command": "npx",
      "args": [
        "argocd-mcp@latest",
        "stdio"
      ],
      "env": {
        "ARGOCD_BASE_URL": "${ARGOCD_MCP_URL}",
        "ARGOCD_API_TOKEN": "${ARGOCD_MCP_TOKEN}"
      },
      "enabled": false
    },
    "signoz": {
      "command": "/Users/igor/.local/bin/signoz-mcp-server",
      "env": {
        "SIGNOZ_URL": "${SIGNOZ_URL}",
        "SIGNOZ_API_KEY": "${SIGNOZ_API_KEY}",
        "LOG_LEVEL": "warn"
      },
      "enabled": true
    }
  }
}
