{
  "mcpServers": {
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp",
      "enabled": false
    },
    "voleeo": {
      "command": "/Applications/Voleeo.app/Contents/MacOS/voleeo-mcp-bridge",
      "env": {
        "VOLEEO_MCP_TOKEN": "${VOLEEO_MCP_TOKEN}"
      },
      "enabled": false
    },
    "argocd-mcp": {
      "command": "npx",
      "args": [
        "argocd-mcp@latest",
        "stdio"
      ],
      "env": {
        "ARGOCD_BASE_URL": "${ARGOCD_MCP_URL}",
        "ARGOCD_API_TOKEN": "${ARGOCD_MCP_TOKEN}"
      },
      "enabled": false
    },
    "mcp-gateway": {
      "type": "http",
      "url": "http://127.0.0.1:8765/",
      "enabled": true
    }
  }
}
