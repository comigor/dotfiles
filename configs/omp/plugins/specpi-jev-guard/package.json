  "private": true,
  "description": "Pi extension that gates dangerous shell and file tool calls with the Jev classifier via OpenRouter",
  "type": "module",
  "author": "Tanner Middleton",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "guardrails",
    "security",
    "openrouter",
    "jev"
  ],
  "license": "MIT",
  "files": [
    "extensions/",
    "upstream.json",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TannerMidd/specpi-jev-guard.git"
  },
  "homepage": "https://tannermidd.github.io/specpi-jev-guard/",
  "pi": {
    "extensions": [
      "./extensions/jev-guard.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "live": "node --env-file-if-exists=.env tests/live-jev.mjs"
  }
}
