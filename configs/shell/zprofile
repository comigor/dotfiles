# Load the shell dotfiles, and then some:
# * ~/.path can be used to extend `$PATH`.
for file in ~/.{aliases,functions,exports,extra,fzf.zsh,nurc,cargo/env} /usr/share/doc/fzf/examples/key-bindings.zsh; do
	[ -r "$file" ] && [ -f "$file" ] && source "$file";
done;
unset file;

# Privileged shells inherit fnox values; ambient staging files would overwrite them.
if [[ -z $ENVBOX_ENV || $ENVBOX_ENV == staging ]]; then
	for file in ~/.{frontierrc,secrets,staging.secrets}; do
		[ -r "$file" ] && [ -f "$file" ] && source "$file"
	done
	unset file
fi

