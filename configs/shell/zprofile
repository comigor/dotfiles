# Load the shell dotfiles, and then some:
# * ~/.path can be used to extend `$PATH`.
# .secrets is the ambient base; .staging.secrets is the staging default.
# Both are always sourced, in every shell.
for file in ~/.{aliases,functions,exports,extra,fzf.zsh,nurc,cargo/env,frontierrc,secrets,staging.secrets} /usr/share/doc/fzf/examples/key-bindings.zsh; do
	[ -r "$file" ] && [ -f "$file" ] && source "$file";
done;
unset file;

# Inside an envbox child this file runs again and would undo the sandbox's
# overrides with staging/base values; re-apply the active env on top.
if [[ -n $ENVBOX_ENV ]]; then
	[ -r "$ENVBOX_ENVFILE" ] && source "$ENVBOX_ENVFILE"
	[ -r "$HOME/.$ENVBOX_ENV.secrets" ] && source "$HOME/.$ENVBOX_ENV.secrets"
fi

