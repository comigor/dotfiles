{
  "$schema": "https://github.com/Mearman/agent-permissions/releases/latest/download/agent-permissions.schema.json",
  "defaultMode": "standard",
  "rules": [
    { "tool": "read", "tier": "allow" },
    { "tool": "grep", "tier": "allow" },
    { "tool": "find", "tier": "allow" },
    { "tool": "ls", "tier": "allow" },
    { "tool": "web_search", "tier": "allow" },
    { "tool": "code_search", "tier": "allow" },
    { "tool": "fetch_content", "tier": "allow" },
    { "tool": "get_search_content", "tier": "allow" },
    { "tool": "lsp_navigation", "tier": "allow" },
    { "tool": "ast_grep_search", "tier": "allow" },
    { "tool": "session_search", "tier": "allow" },
    { "tool": "memory_search", "tier": "allow" },
    { "tool": "ctx_search", "tier": "allow" },
    { "tool": "ctx_stats", "tier": "allow" },
    { "tool": "ctx_doctor", "tier": "allow" },
    { "tool": "subagent", "tier": "allow" },
    { "tool": "AskUserQuestion", "tier": "allow" },

    { "tool": "Bash", "pattern": "rm -rf *", "tier": "deny" },
    { "tool": "Bash", "pattern": "sudo *", "tier": "deny" },

    { "tool": "Bash", "pattern": "git push --force*", "tier": "ask" },

    { "tool": "Bash", "pattern": "kubectl get*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl describe*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl logs*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl top*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl explain*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl version*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl cluster-info*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl api-resources*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl api-versions*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl config view*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl config get-*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl config current-context*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl auth can-i*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl diff*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl wait*", "tier": "allow" },
    { "tool": "Bash", "pattern": "kubectl events*", "tier": "allow" },

    { "tool": "Bash", "pattern": "kubectl apply*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl create*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl delete*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl edit*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl patch*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl replace*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl scale*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl rollout*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl drain*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl cordon*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl uncordon*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl taint*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl label*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl annotate*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl exec*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl attach*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl cp*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl port-forward*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl proxy*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl run*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl set*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl debug*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl config set*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl config use-context*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl config delete-*", "tier": "ask" },
    { "tool": "Bash", "pattern": "kubectl config rename-context*", "tier": "ask" }
  ]
}
