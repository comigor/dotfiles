# GitHub linguist hints for generated code.
# `linguist-generated=true` does two things on github.com:
#   1. collapses the file in PR diffs (still expandable on demand)
#   2. excludes it from the repo's language statistics
# It does NOT block edits or hide files in the worktree.
#
# Resolution rule: later patterns win, so put broad rules first and
# specific overrides for hand-written files at the bottom.

# --- Protobuf / gRPC / grpc-gateway generated Go (anywhere) ---
*.pb.go        linguist-generated=true
*.pb.gw.go     linguist-generated=true
*_grpc.pb.go   linguist-generated=true

# --- Generated SDK / API-surface trees ---
# Most contents of these folders are buf-generated bindings:
#   packages/go/...            -> Go SDK (proto -> .pb.go)
#   packages/typescript/...    -> TS SDK (proto -> .ts via buf)
#   clients/typescript/...     -> TS client (same deal)
#   pkg/api/...                -> Go SDK in pkg-style repos (email-client)
packages/**    linguist-generated=true
clients/**     linguist-generated=true
pkg/**         linguist-generated=true

# --- Generated static assets (embedded swagger/openapi bundles) ---
static/**             linguist-generated=true
**/*.swagger.json     linguist-generated=true
**/*.openapi.json     linguist-generated=true

# --- Lockfiles ---
go.sum             linguist-generated=true
buf.lock           linguist-generated=true
pnpm-lock.yaml     linguist-generated=true
package-lock.json  linguist-generated=true
yarn.lock          linguist-generated=true

# --- Hand-written exceptions (un-mark) ---
# Hand-written DB structs with `dynamo:` tags — schema source of truth,
# we want these visible in diffs.
packages/**/db/**           linguist-generated=false
# Hand-written embed wrappers next to generated assets.
static/static_assets.go     linguist-generated=false
# Hand-written SDK metadata.
packages/**/package.json    linguist-generated=false
packages/**/tsconfig.json   linguist-generated=false
packages/**/README.md       linguist-generated=false
clients/**/package.json     linguist-generated=false
clients/**/tsconfig.json    linguist-generated=false
clients/**/README.md        linguist-generated=false
