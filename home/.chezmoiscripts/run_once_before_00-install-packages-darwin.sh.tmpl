{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -eo pipefail

brew --version || /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# pinentry-rbw-macos comes from the third-party pppobear/tap: tap it, but trust only that
# one formula rather than the whole tap.
brew tap pppobear/tap
brew trust --formula pppobear/tap/pinentry-rbw-macos

brew install git zsh jq awscli fzf bash-completion@2 mise gnupg pinentry-mac ripgrep coreutils rbw bitwarden-cli pinentry-rbw-macos fnox python


{{ end -}}
