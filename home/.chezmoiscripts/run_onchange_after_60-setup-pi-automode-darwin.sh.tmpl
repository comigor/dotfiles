#!/usr/bin/env bash
set -eo pipefail

brew services start ollama 2>/dev/null || true
for i in $(seq 1 30); do
  curl -sf http://127.0.0.1:11434/api/version >/dev/null && break
  sleep 1
done

ollama pull qwen2.5:3b-instruct

export PATH="$HOME/.bun/bin:$PATH"
omp plugin install @czottmann/pi-automode || true

ext="$HOME/.omp/plugins/node_modules/@czottmann/pi-automode/extensions/auto-mode/extension.ts"
if [ -f "$ext" ] && grep -q 'ctx.isProjectTrusted(),' "$ext"; then
  /usr/bin/sed -i '' 's/ctx\.isProjectTrusted(),/typeof ctx.isProjectTrusted === "function" ? ctx.isProjectTrusted() : false,/g' "$ext"
fi

cls="$HOME/.omp/plugins/node_modules/@czottmann/pi-automode/extensions/auto-mode/classifier.ts"
if [ -f "$cls" ] && ! grep -q 'fixedInputTokens' "$cls"; then
  perl -0pi -e 's/const availableActionBytes = Math\.max\(/const fixedInputTokens = Math.ceil(fixedInputUpperBound \/ 3.5);\n  const availableActionBytes = Math.max(/; s/^      fixedInputUpperBound,$/      fixedInputTokens,/m' "$cls"
fi

base="$HOME/.omp/plugins/node_modules/@czottmann/pi-automode/extensions/auto-mode"
python3 - "$base" <<'PYEOF'
import sys, pathlib
base = pathlib.Path(sys.argv[1])

# Patch 3: extract hashline edit targets from input.input
paths = base / "paths.ts"
src = paths.read_text()
if src and "hashline" not in src:
    anchor = '  return typeof value === "string" ? value : undefined;\n}'
    add = '''  // omp hashline edit serializes as { input: "[path#HASH]\\n..." } with no path field.
  const hashline = typeof input.input === "string"
    ? /^\\[([^\\]#]+)#/.exec(input.input)
    : undefined;
  if (hashline) return hashline[1];
  return typeof value === "string" ? value : undefined;
}'''
    assert anchor in src, "paths.ts anchor missing"
    paths.write_text(src.replace(anchor, add, 1))

# Patch 4: classifier soft_deny blocks become interactive asks when UI exists
ext = base / "extension.ts"
src = ext.read_text()
if src and "classifier-ask" not in src:
    anchor = '      state.classifierDenied += 1;\n      return block(ctx, {\n        timestamp: Date.now(),\n        toolName: event.toolName,\n        reason: decision.reason,\n        action: summary,\n        kind: "classifier",\n      }, logCtx);'
    add = '''      if (decision.tier !== "hard_deny" && ctx.hasUI) {
        const approved = await ctx.ui.confirm(
          "Auto mode: action needs approval",
          `${decision.reason}\\n\\n${summary}`,
          { signal: ctx.signal },
        );
        if (approved) {
          state.classifierAllowed += 1;
          return allow(
            ctx,
            "classifier-ask",
            `User approved after auto-mode review: ${decision.reason}`,
            event.toolName,
            summary,
            logCtx,
          );
        }
      }
''' + anchor
    assert anchor in src, "extension.ts anchor missing"
    ext.write_text(src.replace(anchor, add, 1))
PYEOF
