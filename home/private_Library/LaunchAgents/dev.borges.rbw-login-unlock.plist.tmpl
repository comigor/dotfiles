<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.borges.rbw-login-unlock</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/rbw</string>
        <string>unlock</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/rbw-screen-lock/rbw-login-unlock.err.log</string>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/rbw-screen-lock/rbw-login-unlock.out.log</string>
</dict>
</plist>
