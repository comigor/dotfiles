{
  "extends": [
    "nolabs-ai/pi",
    "pi-local-grants"
  ],
  "meta": {
    "name": "pi-local",
    "version": "",
    "description": "Pi with a multi-repo workspace root, plus sandbox-safe git signing and push",
    "author": null
  },
  "security": {
    "signal_mode": null,
    "process_info_mode": null,
    "ipc_mode": null,
    "capability_elevation": null,
    "approval_backends": {},
    "approval_defaults": null,
    "wsl2_proxy_policy": null
  },
  "groups": {
    "include": [],
    "exclude": []
  },
  "commands": {
    "allow": [],
    "deny": []
  },
  "filesystem": {
    "allow": [
      "$HOME/Projects"
    ],
    "read": [
      "$HOME/.pi-bolt",
      "$HOME/.local/bin",
      "/System"
    ],
    "write": [],
    "allow_file": [
      "/history database"
    ],
    "read_file": [
      "$HOME/.gitignore",
      "$HOME/.gitattributes",
      "$HOME/.aliases",
      "$HOME/.exports",
      "$HOME/.curlrc",
      "$HOME/.editorconfig",
      "$HOME/.hushlogin",
      "$HOME/.inputrc",
      "$HOME/.screenrc",
      "$HOME/.tool-versions",
      "$HOME/.wgetrc",
      "$HOME/.zshrc",
      "$HOME/.zprofile",
      "$HOME/.zshenv",
      "$HOME/.ssh/config",
      "$HOME/.ssh/known_hosts",
      "$HOME/.ssh/primary.pub",
      "$HOME/.gnupg/pubring.kbx",
      "$HOME/.gnupg/trustdb.gpg"
    ],
    "write_file": [],
    "unix_socket": [
      "$HOME/.gnupg/S.gpg-agent"
    ],
    "unix_socket_bind": [],
    "unix_socket_dir": [],
    "unix_socket_dir_bind": [],
    "unix_socket_subtree": [],
    "unix_socket_subtree_bind": [],
    "deny": [],
    "bypass_protection": [
      "$HOME/.zshrc",
      "$HOME/.zprofile",
      "$HOME/.zshenv",
      "$HOME/.ssh/config",
      "$HOME/.ssh/known_hosts",
      "$HOME/.ssh/primary.pub",
      "$HOME/.gnupg/pubring.kbx",
      "$HOME/.gnupg/trustdb.gpg",
      "$HOME/.gnupg/S.gpg-agent"
    ],
    "suppress_save_prompt": []
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "allow_domain": [],
    "deny_domain": [],
    "open_port": [],
    "open_port_range": [],
    "listen_port": [],
    "listen_port_range": [],
    "connect_port": [],
    "no_proxy": [],
    "custom_credentials": {},
    "tls_intercept": null,
    "upstream_proxy": null,
    "upstream_bypass": [],
    "approval_backends": {},
    "approval_defaults": null
  },
  "diagnostics": {
    "suppress_system_services": [],
    "redaction": {
      "extra_env_vars": []
    },
    "network_denial_audit": {}
  },
  "linux": {
    "af_unix_mediation": null,
    "sandbox_policy": null
  },
  "env_credentials": {},
  "credential_capture": {},
  "credential_providers": {},
  "credential_routes": [],
  "workdir": {
    "access": "readwrite"
  },
  "hooks": {},
  "session_hooks": {},
  "rollback": {
    "exclude_patterns": [],
    "exclude_globs": []
  },
  "skipdirs": [],
  "packs": [],
  "command_args": [],
  "unsafe_macos_seatbelt_rules": []
}
