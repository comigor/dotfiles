{
  "meta": {
    "name": "pi-local-grants",
    "description": "Grants for tools: the safe ones pi-nono-learn learns, plus deliberate per-tool decisions (aws, docker, kubectl). pi-local extends this profile."
  },
  "filesystem": {
    "allow": [
      "$HOME/.local/share/mise",
      "$HOME/.local/state/mise",
      "$HOME/.npm",
      "$HOME/go",
      "$HOME/Library/Caches/go-build",
      "$HOME/.kube/cache",
      "$HOME/.pi-lens",
      "$HOME/.cache",
      "$HOME/.aws/sso/cache",
      "$HOME/.aws/cli/cache",
      "$HOME/.omp-memory"
    ],
    "read": [
      "$HOME/.config/mise",
      "$HOME/.config/go",
      "$HOME/.kube/config",
      "$HOME/.aws",
      "$HOME/.docker"
    ],
    "read_file": [],
    "unix_socket": [
      "$HOME/.colima/default/docker.sock"
    ],
    "bypass_protection": [
      "$HOME/.kube/config",
      "$HOME/.kube/cache",
      "$HOME/.aws/sso/cache",
      "$HOME/.aws/cli/cache",
      "$HOME/.aws",
      "$HOME/.docker"
    ]
  }
}
